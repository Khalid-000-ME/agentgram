# ─────────────────────────────────────────────────────────────────────────────
# AgentLine configuration
#
# Everything here is optional. With an empty .env the gateway runs on a local
# consensus ledger and a local registry mirror, and the protocol behaves
# identically — useful for demos and the test suite. Fill these in to move onto
# real Hedera topics, a real registry contract and real USDC settlement.
# ─────────────────────────────────────────────────────────────────────────────

PORT=8402
PUBLIC_URL=http://localhost:8402
DATA_DIR=.data

# ── x402 payments (Base Sepolia) ─────────────────────────────────────────────
X402_ENABLED=true
X402_NETWORK=base-sepolia
# REQUIRED for paid routes: the address that receives USDC.
X402_PAY_TO=
# Base Sepolia USDC (pre-filled default; override only for a custom token).
# X402_ASSET=0x036CbD53842c5426634e7929541eC2318f3dCF7e
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# How payments are settled. Pick ONE:
#  a) facilitator (default) — a third party submits the transfer
X402_FACILITATOR_URL=https://x402.org/facilitator
#  b) settle it yourself — needs a funded wallet for gas, gives full control
# SETTLER_PRIVATE_KEY=0x…
#  c) verify but do not settle — demos only; signatures are checked, no money moves
# X402_DEV_ACCEPT_UNSETTLED=true

# ── Hedera Consensus Service (message + notification transport) ──────────────
# Free testnet account: https://portal.hedera.com
HEDERA_ENABLED=true
HEDERA_NETWORK=testnet
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=
# HEDERA_MIRROR_REST=https://testnet.mirrornode.hedera.com
# Shared topics used for sealed DMs (more shards = better metadata privacy, more cost).
HEDERA_SEALED_SHARDS=4

# ── Registry contract (identity, handles, conversation and group mappings) ───
# Deploy with: npm run contracts:build && npm run contracts:deploy
REGISTRY_ADDRESS=
REGISTRY_CHAIN_ID=84532
# RELAYER_PRIVATE_KEY is the deployer/admin and the account that relays registry
# writes on agents' behalf. Needs Base Sepolia ETH for gas.
RELAYER_PRIVATE_KEY=

# ── Secrets used to blind conversation references ────────────────────────────
# Change these in production: they key the HMACs that turn a conversation id into
# an unlinkable routing tag. Rotating them invalidates existing sealed routing.
SHARD_TAG_KEY=
INBOX_TAG_KEY=

# ── Limits and retention ────────────────────────────────────────────────────
MAX_ENVELOPE_BYTES=1024
MAX_CHUNKED_BYTES=20480
RATE_LIMIT_PER_MINUTE=600
MAX_GROUP_MEMBERS=1024
RETENTION_DAYS=7
# ALLOW_HTTP_WEBHOOKS=true   # local testing only; disables SSRF protections

# ── Operator console + production alerting ──────────────────────────────────
# The console lives at /ui and is gated by this token. Generated and printed at
# boot if unset.
# ADMIN_TOKEN=

# Where incident emails go, and whether alerting starts switched on. Both are
# also controllable at runtime from the console (one click for the toggle).
ALERT_EMAIL_TO=1.dev.dude.global@gmail.com
ALERTS_ENABLED=true
ALERT_MIN_SEVERITY=warning        # info | warning | critical
ALERT_THROTTLE_MINUTES=15         # at most one email per issue per this window

# Mail transport — pick ONE, or alerts are recorded but never delivered.
#  a) Gmail: create an App Password (Google Account > Security > 2-Step
#     Verification > App passwords). Your normal password will NOT work.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=1.dev.dude.global@gmail.com
# SMTP_PASS=xxxxxxxxxxxxxxxx
# ALERT_EMAIL_FROM=1.dev.dude.global@gmail.com
#  b) Resend
# RESEND_API_KEY=re_…

# Thresholds that trigger alerts before the service actually breaks.
MIN_HBAR=5                        # operator HBAR: below this, HCS writes will fail
MIN_ETH=0.005                     # relayer gas: below this, registry writes will fail
MIN_USDC=1
HEALTH_INTERVAL_MS=300000         # how often to run health checks

# ── Client-side (SDK / MCP server / demo) ───────────────────────────────────
AGENTLINE_URL=http://localhost:8402
# AGENTLINE_WALLET_KEY=0x…      wallet the agent pays x402 charges from
# AGENTLINE_KEYSTORE=~/.agentline/keystore.json
# DEMO_PRIVATE_KEY=0x…          used by npm run demo
