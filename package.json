{
  "name": "agentline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AgentLine \u2014 x402-paid, end-to-end-encrypted, on-chain messaging hub for autonomous agents",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch apps/gateway/src/index.ts",
    "start": "tsx apps/gateway/src/index.ts",
    "mcp": "tsx packages/mcp/src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "contracts:build": "cd contracts && forge build",
    "contracts:deploy": "tsx scripts/deploy-contracts.ts",
    "hedera:setup": "tsx scripts/setup-hedera.ts",
    "demo": "tsx examples/two-agents-demo.ts",
    "test": "tsx --test test/*.test.ts",
    "doctor": "tsx scripts/doctor.ts"
  },
  "dependencies": {
    "@hashgraph/sdk": "^2.62.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@noble/ciphers": "^1.2.1",
    "@noble/curves": "^1.8.1",
    "@noble/hashes": "^1.7.1",
    "@noble/post-quantum": "^0.2.1",
    "@scure/base": "^1.2.4",
    "@types/nodemailer": "^8.0.2",
    "@x402-avm/extensions": "^2.6.1",
    "@x402/avm": "^2.28.0",
    "@x402/core": "^2.28.0",
    "@x402/express": "^2.28.0",
    "algosdk": "^3.8.0",
    "cbor-x": "^1.6.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "nodemailer": "^10.0.13",
    "tsx": "^4.19.3",
    "viem": "^2.23.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.5",
    "typescript": "^5.7.3"
  }
}
